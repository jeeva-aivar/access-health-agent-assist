DATABASE_URL="postgresql://USER@localhost:5432/access_health_dev"

# NextAuth — both required in production (Amplify). Generate the secret with `openssl rand -base64 32`.
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Demo data source. Leave as "mock" unless wiring to a real backend.
NEXT_PUBLIC_DATA_MODE="mock"

# Live Call Assist backend (deployed claims-call WS).
# next.config.ts proxies /api/agent/:path* -> ${CONVOGENT_AGENT_URL}/:path*.
# If unset, the /api/agent route is not registered (Live Call Assist won't connect).
CONVOGENT_AGENT_URL=""

# Optional: bypass the proxy and connect the browser directly to a WSS URL.
# Leave empty to use the proxied /api/agent/live path (recommended).
NEXT_PUBLIC_AGENT_WS_URL=""

# Bedrock AgentCore IDs (unused by the demo path; only needed if wiring the
# AI Agents pages to a real Bedrock deployment).
DAILY_BRIEF_AGENT_ID=""
EMAIL_AGENT_ID=""
ELIGIBILITY_AGENT_ID=""
NBA_AGENT_ID=""
MIS_AGENT_ID=""
